<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/toolbar_background"
        android:elevation="@dimen/toolbar_elevation"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_max="@dimen/toolbar_height"
        app:title="@string/app_name"
        app:titleTextColor="@color/primary_text">

        <!-- URL Bar -->
        <LinearLayout
            android:id="@+id/url_bar_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/url_bar_height"
            android:layout_marginEnd="8dp"
            android:background="@drawable/url_bar_background"
            android:backgroundTint="@color/url_bar_background"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/url_bar_padding"
            android:paddingEnd="@dimen/url_bar_padding">

            <!-- Security Indicator -->
            <ImageView
                android:id="@+id/security_indicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/neutral_gray"
                tools:ignore="ContentDescription" />

            <!-- URL/Search Bar -->
            <EditText
                android:id="@+id/url_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/url_bar_hint"
                android:imeOptions="actionSearch"
                android:inputType="textUri"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/secondary_text"
                android:textSize="@dimen/text_size_medium"
                android:singleLine="true"
                tools:ignore="Autofill,HardcodedText" />

            <!-- Progress Bar (hidden by default) -->
            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/progress_bar_height"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:indeterminate="false"
                android:max="100"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Menu Button -->
            <ImageView
                android:id="@+id/menu_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/primary_text"
                tools:ignore="ContentDescription" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- WebView Container -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/gecko_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/toolbar_background"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="@dimen/bottom_navigation_elevation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_max="@dimen/bottom_navigation_height"
        app:layout_constraintTop_toBottomOf="@id/webview_container">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/primary_text"
            tools:ignore="ContentDescription" />

        <!-- Forward Button -->
        <ImageButton
            android:id="@+id/forward_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_forward"
            app:tint="@color/primary_text"
            tools:ignore="ContentDescription" />

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            app:tint="@color/primary_text"
            tools:ignore="ContentDescription" />

        <!-- Home Button -->
        <ImageButton
            android:id="@+id/home_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_home"
            app:tint="@color/primary_text"
            tools:ignore="ContentDescription" />

        <!-- New Tab Button -->
        <ImageButton
            android:id="@+id/new_tab_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_new_tab"
            app:tint="@color/primary_text"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <!-- Tab Indicator -->
    <TextView
        android:id="@+id/tab_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/tab_indicator_background"
        android:text="1"
        android:textColor="@color/background"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>